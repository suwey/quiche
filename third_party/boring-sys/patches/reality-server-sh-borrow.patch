@@ -3868,6 +3868,14 @@ struct ssl_st {
   // authenticating a session_id the fork's server would have accepted.
   int reality_ignore_peer_sigalgs = 0;
 
+  // SSL_set_reality_server_hello_borrow() pins the ServerHello's key-share
