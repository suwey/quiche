+  // ServerHello borrowing). Zero |reality_hello_borrow| keeps every other
+  // handshake on boring's own selection.
+  int reality_hello_borrow = 0;
+  uint16_t reality_borrow_cipher_id = 0;
+  uint16_t reality_borrow_group_id = 0;
+
   // renegotiate_mode controls how peer renegotiation attempts are handled.
   ssl_renegotiate_mode_t renegotiate_mode = ssl_renegotiate_never;
 
diff --git a/src/ssl/ssl_lib.cc b/src/ssl/ssl_lib.cc
index 0d6e416..d8e8a1d 100644
--- a/src/ssl/ssl_lib.cc
+++ b/src/ssl/ssl_lib.cc
@@ -775,6 +775,16 @@ void SSL_set_reality_server_ignore_sigalgs(SSL *ssl) {
   ssl->reality_ignore_peer_sigalgs = 1;
 }
 
+void SSL_set_reality_server_hello_borrow(SSL *ssl, uint16_t cipher_id,
+                                         uint16_t group_id) {
+  if (ssl == nullptr) {
+    return;
+  }
+  ssl->reality_borrow_cipher_id = cipher_id;
+  ssl->reality_borrow_group_id = group_id;
+  ssl->reality_hello_borrow = 1;
+}
+
 void SSL_set_accept_state(SSL *ssl) {
   ssl->server = true;
   ssl->do_handshake = ssl_server_handshake;
diff --git a/src/ssl/tls13_server.cc b/src/ssl/tls13_server.cc
index 9d26f4e..26c8237 100644
--- a/src/ssl/tls13_server.cc
+++ b/src/ssl/tls13_server.cc
@@ -240,6 +240,27 @@ static enum ssl_hs_wait_t do_select_parameters(SSL_HANDSHAKE *hs) {
     return ssl_hs_error;
   }
 
+  // SSL_set_reality_server_hello_borrow(): pin the cipher suite to the
+  // destination site's choice when boring knows the id and the peer offered
+  // it. Anything else keeps boring's own selection.
+  if (ssl->reality_hello_borrow) {
+    const SSL_CIPHER *borrowed =
+        SSL_get_cipher_by_value(ssl->reality_borrow_cipher_id);
+    if (borrowed != nullptr) {
+      CBS offered;
+      CBS_init(&offered, client_hello.cipher_suites,
+               client_hello.cipher_suites_len);
+      while (CBS_len(&offered) >= 2) {
+        uint16_t id;
+        CBS_get_u16(&offered, &id);
+        if (id == ssl->reality_borrow_cipher_id) {
+          hs->new_cipher = borrowed;
+          break;
+        }
+      }
+    }
+  }
+
   // HTTP/2 negotiation depends on the cipher suite, so ALPN negotiation was
