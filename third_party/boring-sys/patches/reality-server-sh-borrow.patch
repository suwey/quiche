@@ -295,6 +295,18 @@ OPENSSL_EXPORT int SSL_set_reality_client_hello_params(
 // starting the handshake.
 OPENSSL_EXPORT void SSL_set_reality_server_ignore_sigalgs(SSL *ssl);
 
+// SSL_set_reality_server_hello_borrow configures |ssl|, a REALITY server, to
+// pin the TLS 1.3 ServerHello's key-share group and cipher suite to the
+// values the real destination site selected for the mirrored ClientHello —
+// xtls/reality borrows the destination's ServerHello so that the handshake's
+// visible parameters match the camouflage site's instead of boring's own
+// preferences. Each id is only applied when the peer actually offered it;
+// otherwise boring's own selection is kept. Opt-in per connection: call
+// before starting the handshake; handshakes without this call are untouched.
+OPENSSL_EXPORT void SSL_set_reality_server_hello_borrow(SSL *ssl,
+                                                        uint16_t cipher_id,
+                                                        uint16_t group_id);
+
 // SSL_set_accept_state configures |ssl| to be a server.
 OPENSSL_EXPORT void SSL_set_accept_state(SSL *ssl);
 
diff --git a/src/ssl/extensions.cc b/src/ssl/extensions.cc
index 2f0f8b4..13754c1 100644
--- a/src/ssl/extensions.cc
+++ b/src/ssl/extensions.cc
@@ -327,6 +327,18 @@ bool tls1_get_shared_group(SSL_HANDSHAKE *hs, uint16_t *out_group_id) {
   SSL *const ssl = hs->ssl;
   assert(ssl->server);
 
+  // SSL_set_reality_server_hello_borrow(): a REALITY server pins the
+  // key-share group to the destination site's choice when the peer offered
+  // it. Anything else falls through to boring's own negotiation.
+  if (ssl->reality_hello_borrow) {
+    for (uint16_t group : hs->peer_supported_group_list) {
+      if (group == ssl->reality_borrow_group_id) {
+        *out_group_id = group;
+        return true;
+      }
+    }
+  }
+
   // Clients are not required to send a supported_groups extension. In this
   // case, the server is free to pick any group it likes. See RFC 4492,
   // section 4, paragraph 3.
