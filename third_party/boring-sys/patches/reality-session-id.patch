+void SSL_set_client_session_id_override(SSL *ssl, const uint8_t *id,
+                                        size_t id_len) {
+  if (ssl == nullptr || (id == nullptr && id_len != 0) ||
+      id_len > sizeof(ssl->client_session_id)) {
+    return;
+  }
+  if (id_len == 0) {
+    ssl->client_session_id_len = 0;
+    return;
+  }
+  OPENSSL_memcpy(ssl->client_session_id, id, id_len);
+  ssl->client_session_id_len = static_cast<uint8_t>(id_len);
+}
+
+int SSL_client_key_share_x25519(SSL *ssl, const uint8_t *peer_pub,
+                                uint8_t *out_shared) {
+  if (ssl == nullptr || peer_pub == nullptr || out_shared == nullptr ||
+      !ssl->has_client_x25519_priv) {
+    return 0;
+  }
+  return X25519(out_shared, ssl->client_x25519_priv, peer_pub) == 1;
+}
+
+int SSL_set_reality_client_hello_params(SSL *ssl, const uint8_t *reality_pub,
+                                        const uint8_t *short_id,
+                                        uint32_t timestamp,
+                                        const uint8_t *client_ver) {
+  if (ssl == nullptr || reality_pub == nullptr || short_id == nullptr ||
+      client_ver == nullptr) {
+    return 0;
+  }
+  OPENSSL_memcpy(ssl->reality_pub, reality_pub, sizeof(ssl->reality_pub));
+  OPENSSL_memcpy(ssl->reality_short_id, short_id,
+                 sizeof(ssl->reality_short_id));
+  ssl->reality_timestamp = timestamp;
+  OPENSSL_memcpy(ssl->reality_client_ver, client_ver,
+                 sizeof(ssl->reality_client_ver));
+  ssl->has_reality_params = 1;
+  return 1;
+}
