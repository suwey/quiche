+// ssl_apply_reality_session_id rewrites the legacy session_id of the finished
+// ClientHello |msg| with the XTLS REALITY authentication payload (see
+// SSL_set_reality_client_hello_params in ssl.h).
+//
+// Layout (offsets within the handshake message): the 1-byte session_id length
+// sits at 38 and the session_id at 39 (4-byte handshake header + 2-byte
+// legacy_version + 32-byte random). The plaintext is 16 bytes: client version
+// (3) || 0x00 || big-endian unix timestamp (4) || short_id (8). It is sealed
+// with AES-256-GCM under AuthKey = HKDF-SHA256(ikm = X25519(client key share
+// private, REALITY public), salt = ClientRandom[:20], info = "REALITY"), the
+// nonce is ClientRandom[20..32], and the AAD is the full ClientHello with the
+// session_id field zeroed. The 16-byte ciphertext plus the 16-byte tag
+// exactly fills the 32-byte session_id field.
+//
+// This must run after all ClientHello bytes are final (the AAD covers every
+// extension, key share included — hence the loop: ClientRandom and the key
+// share private only exist inside the library) and before the message enters
+// the handshake transcript, which ssl_add_client_hello satisfies by calling
+// it between finish_message() and add_message(). ssl_add_client_hello is also
+// the HelloRetryRequest second-ClientHello path: ssl_setup_key_shares() has
+// already re-captured the (possibly new) key share private by then, so the
+// session_id is rederived from the key share actually being sent.
+static bool ssl_apply_reality_session_id(SSL_HANDSHAKE *hs,
+                                         bssl::Span<uint8_t> msg) {
+  SSL *const ssl = hs->ssl;
+  // REALITY needs the TLS 1.3 middlebox-compatibility 32-byte session_id,
+  // which is absent on QUIC and renegotiation; fail loudly rather than send
+  // an unauthenticated hello.
+  if (msg.size() < 39 + 32 || msg[38] != 32) {
+    return false;
+  }
+  if (!ssl->has_client_x25519_priv) {
+    return false;
+  }
+  uint8_t shared[32];
+  if (!X25519(shared, ssl->client_x25519_priv, ssl->reality_pub)) {
+    return false;
+  }
+  uint8_t auth_key[32];
+  if (!HKDF(auth_key, sizeof(auth_key), EVP_sha256(), shared, sizeof(shared),
+            ssl->s3->client_random, 20,
+            reinterpret_cast<const uint8_t *>("REALITY"), 7)) {
+    return false;
+  }
+
+  uint8_t plaintext[16];
+  plaintext[0] = ssl->reality_client_ver[0];
+  plaintext[1] = ssl->reality_client_ver[1];
+  plaintext[2] = ssl->reality_client_ver[2];
+  plaintext[3] = 0;
+  plaintext[4] = static_cast<uint8_t>(ssl->reality_timestamp >> 24);
+  plaintext[5] = static_cast<uint8_t>(ssl->reality_timestamp >> 16);
+  plaintext[6] = static_cast<uint8_t>(ssl->reality_timestamp >> 8);
+  plaintext[7] = static_cast<uint8_t>(ssl->reality_timestamp);
+  OPENSSL_memcpy(plaintext + 8, ssl->reality_short_id,
+                 sizeof(ssl->reality_short_id));
+
+  // AAD: the full ClientHello with the session_id field zeroed.
+  bssl::Array<uint8_t> aad;
+  if (!aad.CopyFrom(msg)) {
+    return false;
+  }
+  OPENSSL_memset(aad.data() + 39, 0, 32);
+
+  uint8_t nonce[12];
+  OPENSSL_memcpy(nonce, ssl->s3->client_random + 20, sizeof(nonce));
+  EVP_AEAD_CTX aead;
+  EVP_AEAD_CTX_zero(&aead);
+  if (!EVP_AEAD_CTX_init(&aead, EVP_aead_aes_256_gcm(), auth_key,
+                         sizeof(auth_key), EVP_AEAD_DEFAULT_TAG_LENGTH,
+                         nullptr)) {
+    return false;
+  }
+  size_t out_len = 0;
+  const bool ok =
+      EVP_AEAD_CTX_seal(&aead, msg.data() + 39, &out_len, 32, nonce,
+                        sizeof(nonce), plaintext, sizeof(plaintext),
+                        aad.data(), aad.size()) == 1 &&
+      out_len == 32;
+  EVP_AEAD_CTX_cleanup(&aead);
+  if (!ok) {
+    return false;
+  }
+
+  // Keep hs->session_id consistent with the bytes actually sent (the hello
+  // may be rebuilt, e.g. after a HelloRetryRequest).
+  OPENSSL_memcpy(hs->session_id, msg.data() + 39, 32);
+  hs->session_id_len = 32;
+  return true;
+}
